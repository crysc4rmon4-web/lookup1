# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required by event creation, publication and management routes.
# Configure this separately in Vercel Production and Preview; never use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_NAME=LookUp
EXPO_PUBLIC_APP_NAME=LookUp

# Maps: optional on localhost. Production requires a registered Stadia domain
# or a browser API key restricted to the deployment's domains.
NEXT_PUBLIC_STADIA_MAPS_API_KEY=

# Server geocoding. Override with a Nominatim-compatible service if needed.
LOOKUP_GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
LOOKUP_GEOCODER_USER_AGENT=LookUp/1.0 (+https://lookup1-web.vercel.app)

# Optional AI advice. Without a key, Intelligence uses its existing local analysis.
OPENAI_API_KEY=
